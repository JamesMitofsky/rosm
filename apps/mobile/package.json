{
  "name": "@water-run/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev-server": "expo start --dev-client",
    "android:simulator:dev-server": "expo run:android",
    "ios:simulator:dev-server": "expo run:ios",
    "ios:device:dev-server": "expo run:ios --device",
    "ios:device:release-build": "expo run:ios --device --configuration Release --no-bundler",
    "ios:preview-build:local": "eas build --profile preview --platform ios --local",
    "ios:prod-build:testflight": "eas build --profile production --platform ios --local --output ./build/water-run.ipa",
    "ios:prod-build:xcode": "./scripts/build-ipa.sh",
    "ios:testflight:submit": "./scripts/submit-testflight.sh",
    "uniwind:types": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts",
    "typecheck": "pnpm uniwind:types && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@water-run/core": "workspace:*",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "^58.0.18",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "phosphor-react-native": "^3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "uniwind": "^1.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^58.0.4",
    "expo-mcp": "~0.2.4",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3"
  }
}
