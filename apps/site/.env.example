# Copy to .env.local for local dev. Vercel envs cover deployed environments.

# --- Prod (defaults, do not commit real secrets) ------------------------------
# OSM_OAUTH_BASE=https://www.openstreetmap.org
# OSM_API_BASE=https://api.openstreetmap.org
# OSM_CLIENT_ID=
# OSM_CLIENT_SECRET=

# --- Sandbox (dev.openstreetmap.org) — separate DB + OAuth client -------------
# Register a fresh OAuth 2 app on the sandbox (unrelated to your prod client):
#   https://master.apis.dev.openstreetmap.org/oauth2/applications
# Scopes: read_prefs, write_api
# Redirect URI must match the callback the browser lands on:
#   http://localhost:4321/api/osm/callback
# For a physical device on the LAN, also register:
#   http://<your-machine-lan-ip>:4321/api/osm/callback
OSM_OAUTH_BASE=https://master.apis.dev.openstreetmap.org
OSM_API_BASE=https://api06.dev.openstreetmap.org
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# Optional: keep OAuth + reads live but stub every write. Useful on preview
# deploys pointed at production when you want to verify the flow without
# persisting edits. Not a substitute for the sandbox above.
# OSM_DRY_RUN=1

# --- Formspree (hosted form backend) -----------------------------------------
# One endpoint per form so submissions land in separate inboxes. PUBLIC_ means
# these ship to the browser, which is fine: they are write-only form URLs.
# PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/<waitlist-form-id>
# PUBLIC_FORMSPREE_FEEDBACK_ENDPOINT=https://formspree.io/f/<feedback-form-id>

# --- Overpass (point searches) -----------------------------------------------
# Optional: an Overpass instance tried before the public mirrors, such as a
# paid or self-hosted one.
# OVERPASS_URL=https://overpass.example.org/api/interpreter
# Secret Vercel sends to /api/cron/warm-points. Set it in the Vercel project, or
# the daily DC warm-up is refused.
# CRON_SECRET=
# Dev only: how long a cached cell counts as fresh, in ms (default 1 hour).
# Set it low to try the stale fallback by hand.
# POINT_CACHE_FRESH_MS=60000
