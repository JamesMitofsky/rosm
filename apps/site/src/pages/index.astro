---
import Layout from "@/layouts/Layout.astro";
import BetaCta from "@/components/BetaCta.svelte";
import DemoRunMap from "@/components/DemoRunMap.svelte";
import LiveFountainMap from "@/components/LiveFountainMap.svelte";
import FountainLeaderboard from "@/components/FountainLeaderboard.svelte";
import FreshnessLegend from "@/components/FreshnessLegend.svelte";
import DemoRoutePlaceholder from "@/components/DemoRoutePlaceholder.astro";
import MapAssets from "@/components/MapAssets.astro";
import MapFrame from "@/components/MapFrame.astro";
import { Drop } from "phosphor-svelte";

export const prerender = true;

// Wave-cut silhouette for the manifesto plate. The top and bottom edges roll as
// smooth waves at uneven intervals; the left/right sides stay straight for the
// full-bleed section. Coordinates are objectBoundingBox units (0–1) so the clip
// scales with the element and stays responsive; cubic beziers give true curves,
// which polygon() cannot. Offsets are hardcoded — not random.
// clip-path and the raising drop-shadow live on separate elements: on one element
// the clip runs after the filter and would clip the shadow away to nothing.
const tornShadow =
  "filter: drop-shadow(0 2px 3px rgba(60, 48, 24, 0.32)) drop-shadow(0 9px 18px rgba(60, 48, 24, 0.24));";

// Smooth wave through a list of points. Each segment is a cubic whose control
// points sit at the horizontal midpoint, so consecutive crests/troughs blend
// into a continuous curve rather than kinking at each point.
const r = (n: number) => Math.round(n * 10000) / 10000;
const waveThrough = (pts: { x: number; y: number }[]) =>
  pts
    .slice(1)
    .reduce((d, p, i) => {
      const prev = pts[i];
      const mx = r(prev.x + (p.x - prev.x) / 2);
      return `${d} C ${mx} ${r(prev.y)}, ${mx} ${r(p.y)}, ${r(p.x)} ${r(p.y)}`;
    }, `M ${r(pts[0].x)} ${r(pts[0].y)}`);

// Uneven wave-crest positions along the width; y alternates crest (0) / trough.
const topWave = [
  { x: 0, y: 0.02 }, { x: 0.09, y: 0 }, { x: 0.15, y: 0.03 }, { x: 0.27, y: 0.005 },
  { x: 0.34, y: 0.028 }, { x: 0.48, y: 0 }, { x: 0.55, y: 0.025 }, { x: 0.68, y: 0.004 },
  { x: 0.76, y: 0.03 }, { x: 0.88, y: 0.008 }, { x: 1, y: 0.02 },
];
const bottomWave = [
  { x: 1, y: 0.98 }, { x: 0.88, y: 1 }, { x: 0.76, y: 0.972 }, { x: 0.68, y: 0.996 },
  { x: 0.55, y: 0.975 }, { x: 0.48, y: 1 }, { x: 0.34, y: 0.978 }, { x: 0.27, y: 0.996 },
  { x: 0.15, y: 0.97 }, { x: 0.09, y: 0.995 }, { x: 0, y: 0.98 },
];
const tornPath = `${waveThrough(topWave)} L ${r(bottomWave[0].x)} ${r(bottomWave[0].y)} ${waveThrough(bottomWave).slice(1)} Z`;

// Simpler wave for mobile — fewer crests so narrow screens don't look too busy.
const mobileTopWave = [
  { x: 0, y: 0.022 }, { x: 0.25, y: 0 }, { x: 0.5, y: 0.03 }, { x: 0.78, y: 0.005 }, { x: 1, y: 0.02 },
];
const mobileBottomWave = [
  { x: 1, y: 0.978 }, { x: 0.72, y: 1 }, { x: 0.48, y: 0.972 }, { x: 0.22, y: 0.997 }, { x: 0, y: 0.98 },
];
const mobileTornPath = `${waveThrough(mobileTopWave)} L ${r(mobileBottomWave[0].x)} ${r(mobileBottomWave[0].y)} ${waveThrough(mobileBottomWave).slice(1)} Z`;


// Faint topographic contour lines in the hero foreshadow The Problem below:
// every line traces the same crest/trough silhouette as the manifesto plate's
// torn top edge, stacked and fading in as they descend toward it. The plate
// swaps to a simpler `mobileTopWave` under 768px (see the clip-path media query),
// so the hero builds a matching contour set from each wave and CSS shows the one
// that lines up at the current breakpoint.
const contourRows = 10;
const mobileContourRows = 14; // fewer waves, gap left unwidened so buffer grows instead of overlapping
const waveTopY = 135; // y of the highest contour line, in the 0..600 viewBox
const mobileWaveTopY = 150; // shifted down so the last line lands the same 60-unit buffer above blue as desktop
const waveGap = 45; // vertical spacing between stacked lines (desktop)
const mobileWaveGap = 30; // vertical spacing between stacked lines (mobile) — kept unwidened
const waveAmp = 24; // px crest height (wave dips reach 0.03 of its box)
// Build stacked contour lines that echo a given torn-edge wave. x maps straight
// to width fractions (viewBox is 1200 wide, drawn with preserveAspectRatio="none"
// so 0..1200 = 0..width), so each crest sits at the same x as the manifesto torn
// edge below; y offset by the normalized crest depth so the line echoes it.
// The opacity fade runs relative to this stack's own rows (first row = minOpacity,
// last row = maxOpacity) rather than each line's absolute y position — row counts
// are tuned so no row falls past viewBoxHeight, so there's no off-screen tail to
// throw off the ramp, and the fade always starts faint right at the first row
// regardless of where topY places it.
const contoursFor = (
  wave: { x: number; y: number }[],
  rows: number,
  topY: number,
  gap: number,
  minOpacity: number,
  maxOpacity: number,
) => {
  const waveMax = Math.max(...wave.map((p) => p.y));
  return Array.from({ length: rows }, (_, i) => {
    const baseY = topY + i * gap;
    const pts = wave.map((p) => ({
      x: r(p.x * 1200),
      y: r(baseY + (p.y / waveMax) * waveAmp),
    }));
    const fade = i / (rows - 1);
    return {
      d: waveThrough(pts),
      opacity: minOpacity + (maxOpacity - minOpacity) * fade,
    };
  });
};
const contourLines = contoursFor(topWave, contourRows, waveTopY, waveGap, 0.005, 0.16);
const mobileContourLines = contoursFor(
  mobileTopWave,
  mobileContourRows,
  mobileWaveTopY,
  mobileWaveGap,
  0.002,
  0.2,
);
---

<Layout>
  <MapAssets slot="head" />
  <main class="bg-surface font-body text-base relative">
    {/* HERO */}
    <section class="relative overflow-hidden">
      <svg
        class="pointer-events-none absolute inset-0 h-full w-full" style="color: #0E85C6"
        viewBox="0 0 1200 600"
        fill="none"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <g class="contours-desktop">
          {contourLines.map((l) => (
            <path d={l.d} stroke="currentColor" stroke-width="1" opacity={l.opacity} />
          ))}
        </g>
        <g class="contours-mobile">
          {mobileContourLines.map((l) => (
            <path d={l.d} stroke="currentColor" stroke-width="1" opacity={l.opacity} />
          ))}
        </g>
      </svg>

      <div class="relative mx-auto max-w-6xl px-5 pt-8 pb-16 md:pt-12 md:pb-24">
        {/* Mobile: title -> subtitle -> map (flex column). Desktop: map spans the
            left column, title + subtitle stack in the right column (grid). */}
        <div
          class="flex flex-col items-start gap-2 md:grid md:grid-cols-[46%_1fr] md:items-center md:gap-x-12 md:gap-y-2"
        >
          <h1
            class="reveal font-hero text-hero max-w-5xl text-[clamp(3rem,25vw,5.5rem)] leading-[0.9] font-bold tracking-tight md:col-start-2 md:row-start-1 md:self-end md:text-[clamp(3.2rem,14vw,5.8rem)]"
            style="transition-delay: 0.1s"
          >
            {/* One term per line: the plus signs are the list, not punctuation
                to read across. */}
            Hydration<br />+running<br />+maps
          </h1>

          <div
            class="reveal mb-8 flex flex-col items-start gap-7 md:mb-0 md:col-start-2 md:row-start-2 md:self-start"
            style="transition-delay: 0.16s"
          >
            <p class="text-muted max-w-xl text-lg leading-relaxed">
              Routes made to find DC's drinking fountains
            </p>
          </div>

          {/* Interactive demo of the run + edit flow, framed like a print plate.
              Deliberately not a `.reveal` block: that starts at opacity 0 and
              waits for the scroll observer, which would hide the map's own
              loading frame for exactly the window the frame exists to fill. Its
              dissolve is the entrance. */}
          <div
            class="relative w-full overflow-hidden rounded-xl shadow-lg md:col-start-1 md:row-span-2 md:self-center"
          >
            {/* The loading state is `MapFrame`'s, not the island's: a picture of
                this exact opening view, server-rendered and inline, so it is up
                in the first paint rather than after the island hydrates. */}
            <MapFrame
              frame="demo-run"
              class="hero-map z-0 w-full"
            >
              <DemoRoutePlaceholder slot="placeholder" />
              <DemoRunMap client:only="svelte" />
            </MapFrame>
          </div>
        </div>
      </div>
    </section>

    {/* MANIFESTO SPLIT — a raised, hand-torn surface strip over the page.
        Wrapper casts the shadow; inner section carries the torn clip. */}
    <div class="relative z-10 -my-6" style={tornShadow}>
      <svg width="0" height="0" class="absolute" aria-hidden="true">
        <clipPath id="manifesto-wave" clipPathUnits="objectBoundingBox">
          <path d={tornPath} />
        </clipPath>
        <clipPath id="manifesto-wave-mobile" clipPathUnits="objectBoundingBox">
          <path d={mobileTornPath} />
        </clipPath>
      </svg>
      <section class="bg-blue manifesto-torn">
        <div class="reveal mx-auto max-w-3xl px-5 py-20 md:py-28">
          <h2 class="font-hero text-[clamp(2.5rem,5vw,3.4rem)] leading-[1.05] font-bold tracking-tight text-light">
            The Problem
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-white/85">
            If you're anywhere other than the National Mall, it's hard to know where the public drinking fountains are. Or maybe you've found a map some folks made together, but when you arrive at the fountain, it's either out of order or <em>even removed</em>!
            This unreliability delivers an experience similar to not even having public fountains in the first place, and that's no good for anyone.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-white/85">
            ROSM tackles this problem by making information about each fountain detailed. Things like: is the fountain still here? is it out of order? when was it last checked? who checked it?
            With no expertise in municipal planning, in seems to me that installing the fountain should be the hardest part, not finding it.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-white/85">
            This stands to promote both immediate and long-term benefits:
          </p>
          <ul class="mt-4 list-disc space-y-1 pl-6 text-lg leading-relaxed text-white/85">
            <li>
              <span class="font-medium">Immediately,</span> anyone can reliably locate the nearest
              working fountain
            </li>
            <li>
              <span class="font-medium">Long-term,</span> 311 can be more tightly looped in to when repairs are necessary
            </li>
          </ul>
        </div>
      </section>
    </div>

    <div class="reveal mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-3 px-5 pt-20 pb-2">
      <a
        href="/dc-drinking-fountains"
        class="inline-flex items-center gap-2 rounded-xl bg-transparent px-4 py-2.5 text-base font-bold text-blue transition hover:bg-blue/5 md:gap-2.5 md:px-4 md:py-3 md:text-lg"
      >
        <Drop class="h-5 w-5 md:h-6 md:w-6" weight="fill" />
        Find Water
      </a>
      <BetaCta client:load />
    </div>

    {/* LIVE MAP */}
    <section>
      <div class="mx-auto max-w-6xl px-5 pt-20 pb-10 md:pt-28 md:pb-12">
        <h2
          class="reveal font-hero text-hero text-[clamp(2.5rem,5.5vw,3.6rem)] leading-tight font-bold tracking-tight uppercase"
        >
          Live Map
        </h2>

        <div
          class="reveal mt-6 flex flex-wrap items-center justify-end gap-x-4 gap-y-2 px-1 pb-2"
          style="transition-delay: 0.18s"
        >
          <FreshnessLegend client:visible />
        </div>
        {/* No `.reveal` here either — see the hero map. */}
        <div class="relative overflow-hidden rounded-xl">
          <MapFrame frame="live-fountains-home" class="z-0 w-full">
            <LiveFountainMap client:only="svelte" />
          </MapFrame>
        </div>
      </div>
    </section>

    {/* RANKINGS */}
    <section>
      <div class="mx-auto max-w-6xl px-5 pt-20 pb-10 md:pt-28 md:pb-12">
        <h2
          class="reveal font-hero text-hero text-[clamp(2.5rem,5.5vw,3.6rem)] leading-tight font-bold tracking-tight uppercase"
        >
          Rankings
        </h2>
        <div class="reveal mt-6" style="transition-delay: 0.14s">
          <FountainLeaderboard client:visible />
        </div>
      </div>
    </section>

    {/* BOTTOM CTA */}
    <section>
      <div class="reveal mx-auto flex max-w-6xl flex-col items-center gap-6 px-5 py-12 md:py-16">
        <h2
          class="font-hero text-hero text-center text-[clamp(2.5rem,5vw,3.4rem)] leading-tight font-bold tracking-tight"
        >
          Help map the map!
        </h2>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/dc-drinking-fountains"
            class="inline-flex items-center gap-2.5 rounded-xl bg-transparent px-4 py-3 text-lg font-bold text-blue transition hover:bg-blue/5"
          >
            <Drop class="h-6 w-6" weight="fill" />
            Find Water
          </a>
          <BetaCta client:load />
        </div>
      </div>
    </section>

    {/* FOOTER */}
    <footer>
      <div class="text-muted mx-auto flex max-w-6xl items-center justify-center gap-4 px-5 py-8 text-sm">
        <span>
          Made with{" "}
          <Drop class="inline-block h-4 w-4 align-middle" style="color: #0E85C6" weight="fill" />{" "}
          by{" "}
          <a
            href="https://jamesm.it/about"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link decoration-link/50 hover:decoration-link font-medium underline underline-offset-4"
          >
            James Mitofsky
          </a>
        </span>
      </div>
    </footer>
  </main>

  <script>
    // Scroll-reveal (was framer-motion fadeUp): reveal each `.reveal` block as it
    // crosses into view, once. Positive bottom rootMargin extends the trigger zone
    // below the viewport so blocks start revealing while still under the fold.
    const els = document.querySelectorAll<HTMLElement>(".reveal");
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            obs.unobserve(entry.target);
            // Free GPU layer once animation is done — will-change is expensive to hold
            (entry.target as HTMLElement).addEventListener(
              "transitionend",
              () => { (entry.target as HTMLElement).style.willChange = "auto"; },
              { once: true },
            );
          }
        }
      },
      { rootMargin: "0px 0px 20% 0px", threshold: 0 },
    );
    els.forEach((el) => io.observe(el));
  </script>
<style>
  .manifesto-torn {
    clip-path: url(#manifesto-wave);
  }
  /* Hero contours mirror the manifesto torn edge; show the set matching the
     wave the plate uses at this breakpoint (swap point must match the clip-path
     media query below). */
  .contours-mobile {
    display: none;
  }
  @media (max-width: 767px) {
    .manifesto-torn {
      clip-path: url(#manifesto-wave-mobile);
    }
    .contours-desktop {
      display: none;
    }
    .contours-mobile {
      display: inline;
    }
  }
</style>
</Layout>
