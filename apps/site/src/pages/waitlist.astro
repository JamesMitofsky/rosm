---
import ContentPage from "@/layouts/ContentPage.astro";
import WaitlistForm from "@/components/WaitlistForm.svelte";

export const prerender = true;
---

<ContentPage
  title="Join the waitlist — Water Run"
  description="Access is opening in waves. Add yourself to the waitlist and we'll send an invite when your spot comes up."
  heading="Join the waitlist"
>
  <p class="text-muted mt-6 text-lg leading-relaxed">
    We're opening access in waves. Add yourself to the waitlist and we'll send an invite when your
    spot comes up.
  </p>
  <div class="mt-8">
    <WaitlistForm client:load />
  </div>
</ContentPage>
