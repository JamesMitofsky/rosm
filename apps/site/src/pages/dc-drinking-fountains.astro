---
import Layout from "@/layouts/Layout.astro";
import LiveFountainMap from "@/components/LiveFountainMap.svelte";
import FreshnessLegend from "@/components/FreshnessLegend.svelte";
import MapAssets from "@/components/MapAssets.astro";
import MapFrame from "@/components/MapFrame.astro";

export const prerender = true;
---

<Layout
  title="DC Drinking Fountains — Live Map"
  description="A live map of public drinking fountains in Washington, DC, sourced from OpenStreetMap and graded by verification recency."
>
  <MapAssets slot="head" />
  <main class="bg-surface font-body text-base relative min-h-screen">
    <section>
      <div class="mx-auto max-w-6xl px-5 pt-4 pb-12 md:pb-20">
        <h1
          class="font-hero text-hero text-[clamp(2rem,5.5vw,3.6rem)] leading-tight tracking-tight"
        >
          DC Drinking Fountains
        </h1>
        <div class="mt-4 flex flex-wrap items-center justify-end gap-x-4 gap-y-2 px-1 pb-2">
          <FreshnessLegend client:visible />
        </div>

        <div class="bg-info relative overflow-hidden rounded-xl shadow-lg">
          <MapFrame frame="live-fountains-dc" class="z-0 w-full">
            <LiveFountainMap client:only="svelte" />
          </MapFrame>
        </div>
      </div>
    </section>
  </main>
</Layout>
