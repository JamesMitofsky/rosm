---
import Layout from "@/layouts/Layout.astro";

export const prerender = true;

// Decorative topographic contour field, echoing the landing hero.
const lines = Array.from({ length: 9 }, (_, i) => {
  const o = i * 26;
  return {
    d: `M-50 ${120 + o} C 200 ${60 + o}, 360 ${220 + o}, 560 ${180 + o} S 920 ${60 + o}, 1260 ${160 + o}`,
    opacity: 0.5 - i * 0.04,
  };
});
---

<Layout title="Off the map — 404" description="This route doesn't exist yet.">
  <main
    class="bg-surface font-body relative flex flex-1 flex-col items-center justify-center overflow-hidden px-6 text-center text-base"
  >
    <svg
      class="pointer-events-none absolute inset-0 h-full w-full text-base opacity-[0.08]"
      viewBox="0 0 1200 600"
      fill="none"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      {
        lines.map((l) => (
          <path d={l.d} stroke="currentColor" stroke-width="1" opacity={l.opacity} />
        ))
      }
    </svg>

    <div class="relative z-10 flex flex-col items-center">
      <h1 class="font-display text-4xl font-bold sm:text-5xl">Off the Map</h1>
      <p class="text-muted mt-3 max-w-xl text-balance">
        Whoops, this route isn't on any survey we know! It might have moved, or never existed.
      </p>

      <a
        href="/"
        class="group bg-blue text-surface mt-8 inline-flex items-center gap-2 rounded-xl px-8 py-3.5 font-bold"
      >
        Return Home
        <svg viewBox="0 0 256 256" fill="currentColor" class="h-[18px] w-[18px]" aria-hidden="true">
          <path
            d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"
          ></path>
        </svg>
      </a>
    </div>
  </main>
</Layout>
