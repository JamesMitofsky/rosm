---
import "@/styles/globals.css";
import MobileNav from "@/components/MobileNav.svelte";
// Brand mark, inlined: every page is a fresh document, and a `public/` image
// is re-validated on each load (`max-age=0`), so as a request it painted a
// beat after the header text and popped in. Derived by scripts/build-header-assets.ts.
import logoSrc from "@/assets/logo-120.png?inline";
import { APP_NAME } from "@/lib/appConfig";
// Which nav item is the page the visitor is on. Trailing slash stripped so
// `/public-drinking-fountains/` and `/public-drinking-fountains` count as the same page.
const currentPath = Astro.url.pathname.replace(/(.)\/$/, "$1");
const isCurrent = (href: string) => (currentPath === href ? "page" : undefined);
// Favicons live in public/icons; the OG card embeds public/icons/logo.png at build.

const APP_DESCRIPTION =
  "Turn your run into open-map fieldwork. Plan a route past unverified OpenStreetMap points, run it with turn-by-turn cues, and fix the map from the ground.";

// Absolute base for resolving OG/twitter image URLs. Prefer an explicit site URL,
// fall back to the Vercel production domain, then the known deploy target.
const SITE_URL =
  import.meta.env.PUBLIC_SITE_URL ??
  (import.meta.env.VERCEL_PROJECT_PRODUCTION_URL
    ? `https://${import.meta.env.VERCEL_PROJECT_PRODUCTION_URL}`
    : "https://rosm.vercel.app");

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results. Pair with a Disallow in public/robots.txt. */
  noindex?: boolean;
  /**
   * Pin the page to the viewport: the body becomes a column exactly one
   * viewport tall, the header keeps its own height, and the page's `<main>`
   * takes the rest. Page-level scrolling is off — the page's content owns its
   * box. For pages that are one full-bleed surface, like the live map.
   *
   * Sized with `h-dvh`, not `h-full`: the html element's 100% is the layout
   * viewport, which on phones does not track the browser chrome sliding away,
   * and a map pinned to it would leave a strip of page under the toolbar.
   */
  fullscreen?: boolean;
}

const {
  title = "Run Verified Fountains — Running for Open-Sourced Maps",
  description = APP_DESCRIPTION,
  noindex = false,
  fullscreen = false,
} = Astro.props;

// Editorial social card, rendered to a static PNG at build time (Satori + resvg).
const ogImage = new URL("/opengraph-image.png", SITE_URL).href;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="application-name" content={APP_NAME} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Performance Resource Hints -->
    <link rel="preload" href="/fonts/Jua-Latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Per-page head additions. Map pages pass `MapAssets` here, which is what
         warms the tile host and pulls the engine download forward; pages
         without a map should not open a TLS connection they never use. -->
    <slot name="head" />

    <!-- Icons -->
    <link rel="icon" href="/icons/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <!-- Flex column so a page's `main` can `flex-1` to the viewport floor without
       double-counting the header (a `min-h-dvh` on `main` overflows by exactly
       the header's height). `fullscreen` pins that column to one viewport. -->
  <body class:list={["flex min-h-full flex-col", fullscreen && "h-dvh overflow-hidden"]}>
    {
      /* From `sm` up, inline padding must be at least the `nav-link` splotch bleed (`-mx-6`
        in globals.css): the last nav item's box hangs that far past the nav's
        edge, and anything short of it pokes out of the viewport and gives the
        page a horizontal scrollbar. Below `sm` the nav is hidden, so the bar
        keeps the 20px the page content uses. */
    }
    <header class="flex shrink-0 items-center justify-between px-5 py-4 sm:px-6">
      {
        /* Logo sits top-left at every width and is the way home. 120px source
          = 3x the 40px render so it stays crisp on high-DPI screens. Decoded
          synchronously so it is in the first paint rather than a frame after. */
      }
      <a href="/" class="nav-brand flex items-center w-fit" aria-label={APP_NAME}>
        <img
          src={logoSrc}
          alt={APP_NAME}
          width="120"
          height="120"
          decoding="sync"
          class="h-10 w-10"
        />
      </a>
      {
        /* Nav wears the section-heading face. Jua ships one weight, so nothing
          here asks for bold — it would be synthesized. */
      }
      <nav class="font-hero hidden sm:flex items-center gap-12">
        <a href="/" class="nav-link" aria-current={isCurrent("/")}>
          {
            /* Phosphor "house" (fill weight, matching the mobile menu), inline for the same reason as the map below:
              the header is on every page and shouldn't carry an icon island. */
          }
          <svg
            width="16"
            height="16"
            viewBox="0 0 256 256"
            fill="currentColor"
            aria-hidden="true"
            class="h-4 w-4"
          >
            <path
              d="M224,120v96a8,8,0,0,1-8,8H160a8,8,0,0,1-8-8V164a4,4,0,0,0-4-4H108a4,4,0,0,0-4,4v52a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V120a16,16,0,0,1,4.69-11.31l80-80a16,16,0,0,1,22.62,0l80,80A16,16,0,0,1,224,120Z"
            ></path>
          </svg>
          Home
        </a>
        <a
          href="/public-drinking-fountains"
          class="nav-link"
          aria-current={isCurrent("/public-drinking-fountains")}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 256 256"
            fill="currentColor"
            aria-hidden="true"
            class="h-4 w-4"
          >
            <path
              d="M228.92,49.69a8,8,0,0,0-6.86-1.45L160.93,63.52,99.58,32.84a8,8,0,0,0-5.52-.6l-64,16A8,8,0,0,0,24,56V200a8,8,0,0,0,9.94,7.76l61.13-15.28,61.35,30.68A8.15,8.15,0,0,0,160,224a8,8,0,0,0,1.94-.24l64-16A8,8,0,0,0,232,200V56A8,8,0,0,0,228.92,49.69ZM96,176a8,8,0,0,0-1.94.24L40,189.75V62.25L95.07,48.48l.93.46Zm120,17.75-55.07,13.77-.93-.46V80a8,8,0,0,0,1.94-.23L216,66.25Z"
            ></path>
          </svg>
          Map
        </a>
        <a href="/waitlist" class="nav-link" aria-current={isCurrent("/waitlist")}>
          <svg
            width="16"
            height="16"
            viewBox="0 0 256 256"
            fill="currentColor"
            aria-hidden="true"
            class="h-4 w-4"
          >
            <path
              d="M221.8,175.94C216.25,166.38,208,139.33,208,104a80,80,0,1,0-160,0c0,35.34-8.26,62.38-13.81,71.94A16,16,0,0,0,48,200H88.81a40,40,0,0,0,78.38,0H208a16,16,0,0,0,13.8-24.06ZM128,216a24,24,0,0,1-22.62-16h45.24A24,24,0,0,1,128,216Z"
            ></path>
          </svg>
          Waitlist
        </a>
      </nav>
      <div class="sm:hidden">
        <MobileNav client:load {currentPath} />
      </div>
    </header>
    <slot />
  </body>
</html>
